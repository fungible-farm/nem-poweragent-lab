.venv/
__pycache__/
*.pyc
target/
data/*
!data/README.md
benchmarks/power-agent-bench-lite/results/*
!benchmarks/power-agent-bench-lite/results/.gitkeep
*.cast
*.gguf
# Rendered demo animations -- regenerated by the committed labs/*/animate_*.py
# scripts from real physics/fixture data on demand, never committed (the
# script is the artifact, the MP4 is a render).
*.mp4
# Sonification render (view_3d_audio.py) -- regenerated from real data.
*.wav
# pyinfra writes a debug log to CWD on a crashed run.
pyinfra-debug.log
# b00t session artifacts -- this box runs b00t tooling (b00t learn/mcp), but
# the repo itself has no b00t dependency; keep its session files out of git.
.b00tignore
_b00t_.toml

# Lab 5: dpsimpy's own per-component logging (any component/Simulation
# built with LogLevel above `warn`) writes here by default -- defensive
# ignore, not expected to appear from the committed scripts' own log levels.
# Unanchored (not `/logs/`): dpsimpy creates this relative to whatever CWD a
# run happens to use, which in practice has been both repo root and
# labs/05-spartan-chaosnet-transient-stream/ -- cover both.
logs/
# Lab 5: regenerated by run_dpsim.py on every run (real DPsim output, not
# hand-written) -- committed fixtures are sample_topology.json,
# expected_topology.json, expected_dpsim_run.json,
# sample_stream_summary.json, and sample_transient_plot.png instead.
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log.json
labs/05-spartan-chaosnet-transient-stream/villas/chaos_stream.csv
