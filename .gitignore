.venv/
__pycache__/
*.pyc
target/
data/*
!data/README.md
benchmarks/power-agent-bench-lite/results/*
!benchmarks/power-agent-bench-lite/results/.gitkeep
*.cast
*.gguf
# Rendered demo animations -- regenerated by the committed labs/*/animate_*.py
# scripts from real physics/fixture data on demand, never committed (the
# script is the artifact, the MP4 is a render).
*.mp4
# Sonification render (view_3d_audio.py) -- regenerated from real data.
*.wav
# pyinfra writes a debug log to CWD on a crashed run.
pyinfra-debug.log
# b00t session artifacts -- this box runs b00t tooling (b00t learn/mcp), but
# the repo itself has no b00t dependency; keep its session files out of git.
.b00tignore
_b00t_.toml

# Lab 5: dpsimpy's own per-component logging (any component/Simulation
# built with LogLevel above `warn`) writes here by default -- defensive
# ignore, not expected to appear from the committed scripts' own log levels.
# Unanchored (not `/logs/`): dpsimpy creates this relative to whatever CWD a
# run happens to use, which in practice has been both repo root and
# labs/05-spartan-chaosnet-transient-stream/ -- cover both.
logs/
# Lab 5: regenerated by run_dpsim.py on every run (real DPsim output, not
# hand-written) -- committed fixtures are sample_topology.json,
# expected_topology.json, expected_dpsim_run.json,
# sample_stream_summary.json, and sample_transient_plot.png instead.
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log.json
labs/05-spartan-chaosnet-transient-stream/villas/chaos_stream.csv
# PRD-0005 Phase 1: grid_forming.py's stabilized-run log and the real
# before/after comparison it computes -- both regenerated by
# grid_forming.py on every run, same rationale as dpsim_transient_log.json
# above.
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log_stabilized.json
labs/05-spartan-chaosnet-transient-stream/stabilizer_comparison.json
# PRD-0005 Phase 1.5: headroom_translation.py's own real baseline/translated
# pandapower limit-screen result -- regenerated by headroom_translation.py
# on every run, same rationale as stabilizer_comparison.json above.
labs/05-spartan-chaosnet-transient-stream/headroom_translation.json
# PRD-0005 Phase 2: delay_compensation.py's own real three-way (no
# stabilizer / no delay compensation / with delay compensation) comparison
# and its supporting DPsim logs -- all regenerated on every run, same
# rationale as stabilizer_comparison.json above.
labs/05-spartan-chaosnet-transient-stream/delay_compensation.json
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log_stabilized_delay_comp.json
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log_stabilized_repro_check.json
# PRD-0005 Phase 3: renewable_source.py's own real wind-speed/power-output
# series -- regenerated by run_dpsim.py --renewable on every run, same
# rationale as stabilizer_comparison.json above.
labs/05-spartan-chaosnet-transient-stream/renewable_generation.json
labs/05-spartan-chaosnet-transient-stream/dpsim_transient_log_renewable_check.json

# Lab 6: everything under output/ is regenerated by the pipeline scripts
# (generate_sysml.py/translate_iso_ir.py/render_diagram.py/generate_sbom.py
# --step run) from the committed schema/instance YAML on every run --
# committed fixtures live in fixtures/ instead (expected_*.sysml,
# expected_*_iso_ir.json, expected_*.svg, expected_sbom.json,
# k8s_snapshot.json).
labs/06-sysml-digital-thread/output/
# Lab 3 pypowsybl spike (spike_pypowsybl.py): the real .mat MATPOWER round-trip and the
# comparison JSON it computes are both regenerated on every run -- committed fixture is
# expected_pypowsybl_comparison.json instead, same rationale as Lab 5's entries above.
labs/03-advanced-provider-bakeoff/spike_output/
# Lab 2 pypowsybl N-1 cross-check (pypowsybl_cross_check.py): same rationale as the Lab 3 entry
# above -- committed fixture is expected_pypowsybl_n1_comparison.json instead.
labs/02-medium-interconnection-screening/pypowsybl_output/

# docs/backlog/0005: notebooks/lab_playbook.py (jupytext percent format) is
# the committed source; its rendered .ipynb (jupytext --to notebook
# --execute) is a regenerated execution artifact with outputs baked in --
# exactly the "ad hoc session masquerading as proof" AGENTS.md warns about
# if committed, and the whole reason percent format was chosen over a raw
# .ipynb in the first place. Never commit it.
notebooks/*.ipynb
